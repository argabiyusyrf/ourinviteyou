# ============================================================
# Undangan Pernikahan — Faisal & Detika
#
#   /isalyaya      -> panel manajemen (manaje.html)
#   /nama-tamu     -> undangan tamu (index.html), contoh: /arya /ratih
#
# Catatan: tanpa RewriteBase agar aturan tetap sah baik saat
# situs ada di webroot MAUPUN di subfolder (mis. /undangan/).
# Nama tamu dibaca oleh main.js dari pathname (dash -> spasi).
# ============================================================

RewriteEngine On

# -- 0a) Paksa HTTPS di production (abaikan localhost & IP lokal).
#     Di lokal (http://localhost/undangan) tetap http://.
#     Cek X-Forwarded-Proto supaya tak loop saat di balik proxy SSL.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|::1)$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_X_FORWARDED_PROTO} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -- 0) Blokir semua path bertitik (.git/, .htaccess, dsb.)
RewriteRule (^|/)\. - [F]

# -- 0b) Data privat backend tidak boleh diakses langsung
RewriteRule ^data/ - [F]

# -- 1) File/folder yang benar-benar ada -> dilayani apa adanya
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -- 2) Panel manajemen (path rahasia) — HARUS sebelum catch-all
RewriteRule ^isalyaya/?$ manaje.html [L]

# -- 3) Link cantik tamu: SATU segmen tanpa titik -> index.html
#    /arya -> index.html ; /ratih -> index.html ; dst.
RewriteRule ^([^./]+)/?$ index.html [L]

# -- 4) Sisa path tak dikenal -> halaman 404 ber-branding
RewriteRule ^ 404.php [L]

# -- 5) Kebersihan & keamanan
Options -Indexes

# Halaman HTML tidak di-cache browser agar edit langsung terlihat
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "(^\.|\.(md|log|ini|sh|json|tmp)$)">
  Require all denied
</FilesMatch>
