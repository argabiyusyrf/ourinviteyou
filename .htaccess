RewriteEngine On
RewriteBase /undangan/

# Don't rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Management panel (secret path) - must be BEFORE pretty URL catch-all
RewriteRule ^isalyaya/?$ manaje.html [L]

# Pretty URL: /nama-tamu -> index.html (undangan tamu)
RewriteRule ^([^/]+)/?$ index.html [L]

# Default: serve index.html for root
RewriteRule ^$ index.html [L]
